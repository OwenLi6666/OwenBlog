{
  "cleanUrls": false,
  "trailingSlash": false,
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_MESSAGE\" in *\"[skip-version]\"*) exit 0;; *) exit 1;; esac",
  "headers": [],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "owenpower.com"
        }
      ],
      "destination": "https://dragonll.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.owenpower.com"
        }
      ],
      "destination": "https://dragonll.com/:path*",
      "permanent": true
    }
  ]
}
